      "tool": "execute",
      "input": "{\"command\":\"id\"}",
      "matches": true
    },
    {
      "server": "mcp-runcommand-server2",
      "tool": "run",
      "input": "{}",
      "matches": true
    },
    {
      "server": "mcp-runcommand-server-docs",
      "tool": "search",
      "input": "{}",
      "matches": false
    },
    {
      "server": "github",
      "tool": "create_issue",
      "input": "{}",
      "matches": false
    },
    {
      "server": "shell",
      "tool": "run",
      "input": "{\"command\":\"id\"}",
      "matches": false
    }
  ]
}
