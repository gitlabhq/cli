{
  "target": "file",
  "operations": [
    "any"
  ],
  "path_patterns": [
    "^(/Users/[^/]+|/home/[^/]+|/root|[A-Za-z]:/Users/[^/]+)/\\.config/(gh|heroku|vercel|glab-cli)(/|$)",
    "^(/Users/[^/]+|/home/[^/]+|/root|[A-Za-z]:/Users/[^/]+)/\\.(fly|now)(/|$)",
    "^(/Users/[^/]+|/home/[^/]+|/root|[A-Za-z]:/Users/[^/]+)/Library/Application Support/(glab-cli|com\\.vercel\\.cli)(/|$)",
    "^(/Users/[^/]+|/home/[^/]+|/root|[A-Za-z]:/Users/[^/]+)/\\.local/share/com\\.vercel\\.cli(/|$)"
  ],
  "vectors": [
    {
      "operation": "read",
      "path": "/Users/dev/.config/gh/hosts.yml",
      "matches": true
