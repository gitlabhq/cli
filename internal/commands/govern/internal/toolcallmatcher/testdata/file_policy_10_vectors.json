      "path": "/Users/dev/.config/heroku/config.json",
      "matches": true
    },
    {
      "operation": "read",
      "path": "/Users/dev/.config/glab-cli/config.yml",
      "matches": true
    },
    {
      "operation": "read",
      "path": "/Users/dev/Library/Application Support/glab-cli/config.yml",
      "matches": true
    },
    {
      "operation": "read",
      "path": "/Users/dev/Library/Application Support/com.vercel.cli/auth.json",
      "matches": true
    },
    {
      "operation": "read",
      "path": "/home/dev/.local/share/com.vercel.cli/auth.json",
      "matches": true
    },
    {
      "operation": "read",
      "path": "/repo/.github/workflows/ci.yml",
      "matches": false
    },
    {
      "operation": "read",
      "path": "/repo/fly.toml",
      "matches": false
    },
    {
